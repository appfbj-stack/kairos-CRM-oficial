# =====================================================
# Kairos CRM — Environment Variables (exemplo)
# Copie para .env e ajuste os valores
# =====================================================

# --- Geral ---
NODE_ENV=development

# --- API (Fastify) ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Banco de Dados (Postgres) ---
# Local (docker-compose)
DATABASE_URL=postgresql://kairos_crm:kairos_crm_secret@localhost:5433/kairos_crm_db?schema=public

# Produção (VPS — kairos-shared-pg)
# DATABASE_URL=postgresql://kairos_igreja_user:****@kairos-shared-pg:5432/kairos_crm_db?schema=public

# --- JWT ---
# Gere com: openssl rand -base64 64
JWT_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres
JWT_REFRESH_SECRET=troque-por-outra-string-aleatoria-diferente-da-acima
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Senha / Segurança ---
BCRYPT_ROUNDS=12

# --- Logs ---
LOG_LEVEL=info

# --- Super Admin inicial (criado pelo seed) ---
SEED_SUPER_ADMIN_EMAIL=admin@kairoscrm.com
SEED_SUPER_ADMIN_PASSWORD=Troque@Senha123
SEED_SUPER_ADMIN_NAME=Super Admin Kairos
